# 复制这个文件为 .env，然后修改里面的值

# 命令：cp .env.example .env

# 服务监听端口

PORT=3000

# JWT 密钥，随便写一长串随机字符（部署到正式服务器前一定要改成你自己的，不要用示例值）

JWT_SECRET=please-change-this-to-a-random-long-string-before-deploy

# 管理后台初始账号密码（首次启动时会自动创建这个管理员账号，之后可以在后台改密码）

ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=admin123456

# 是否开启"开发模式登录"（用手机号/昵称直接登录，不校验微信）

# 上线前，等你申请好微信支付/正式对接微信登录后，把这个改成 false，

# 并在 routes/auth.js 里把 wx-login 接口换成真正调用微信 code2Session 的逻辑

DEV_LOGIN_ENABLED=true